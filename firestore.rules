rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public or authenticated access for app functionality
    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /food_logs/{logId} {
      allow read, write: if true;
    }
    
    match /daily_summaries/{summaryId} {
      allow read, write: if true;
    }
    
    match /research_logs/{researchId} {
      allow read, write: if true;
    }
  }
}
